IS_HAILO_ON_DEVICE="FALSE"
HAILO_VERSION="VOSK" ## HAILO8, HAILO8L, VOSK
VOSK_MODEL_PATH="requirements_files/vosk-model-uk-v3-lgraph" ## Path to VOSK model directory; used only when HAILO_VERSION=VOSK
TTS_ENGINE_BINARY="piper" ## espeak-ng | piper
TTS_DEFAULT_VOICE="requirements_files/piper_models/uk/uk_UA-ukrainian_tts-medium.onnx" ## espeak voice code 'uk' OR piper .onnx model path
